rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 允許所有人讀取和寫入 artifacts 下的所有資料
    // 注意：這代表知道您 Project ID 的人理論上都能存取資料
    // 但對於這種非機密的旅遊行程 App 來說，這是最方便的設定
    match /artifacts/{document=**} {
      allow read, write: if true;
    }
    
    // 如果您想稍微安全一點，可以改成這樣 (僅限您的 App 使用者)
    // 但因為我們用的是匿名登入，其實效果差不多
    // match /artifacts/{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}